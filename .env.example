# Generate a unique secret for this local control plane. Never commit the filled .env.
AGENTSCOPE_ADMIN_TOKEN=replace-with-a-random-secret
AGENTSCOPE_PUBLIC_URL=http://127.0.0.1:8000

# Persistent state; keep it outside the Git checkout.
AGENTSCOPE_STATE_DIR=/var/lib/agentscope
AGENTSCOPE_TASK_ROOT=/var/lib/agentscope/tasks
AGENTSCOPE_DB=/var/lib/agentscope/agentscope.sqlite3
AGENTSCOPE_POLICY_DIR=/var/lib/agentscope-protected/policies
AGENTSCOPE_CORPUS_ROOT=/var/lib/agentscope/import/corpus

# Runtime integrations. Set these for the target Linux VM and its service users.
ACTPLANE_BIN=/usr/local/bin/actplane
DSH_BIN=/usr/local/bin/dsh
DSH_HOME=/var/lib/agentscope-agent/.dsh
AGENTSCOPE_DSH_HOME=/var/lib/agentscope-agent/.dsh
AGENTSCOPE_BROKER_SOCKET=/run/agentscope/broker.sock
AGENTSCOPE_RUNTIME_DIR=/run/agentscope
AGENTSCOPE_LOG_DIR=/var/log/agentscope
AGENTSCOPE_EXEC_PATH=/opt/node22/bin:/opt/agentscope/bin:/opt/agentscope/dsh/node_modules/.bin:/usr/local/bin:/usr/bin:/bin
AGENTSCOPE_APP_USER=hezhipeng
AGENTSCOPE_AGENT_USER=agentscope-agent
# Leave empty to keep controlled Agent execution disabled. Set to production only
# on hosts where ActPlane, cgroup v2, bubblewrap, and the Agent runtime were verified.
AGENTSCOPE_CONTROLLED_INSTANCE_PROFILE=
# Optional read-only Python environment published inside controlled sandboxes
# as /opt/task-python. DSH does not require it.
AGENTSCOPE_TASK_PYTHON=
# Broker-owned controlled-instance state. Keep this outside API-private state
# when the API and controlled Agent use different Unix identities.
AGENTSCOPE_INSTANCE_ROOT=
# JSON array of canonical host directories whose direct children may be registered.
AGENTSCOPE_RESOURCE_ROOTS=
AGENTSCOPE_TASK_GROUP=agentscope-task
AGENTSCOPE_CONTROL_GROUP=agentscope-control
AGENTSCOPE_SERVICE_HOME=/var/lib/agentscope
AGENTSCOPE_RUNNER=/opt/agentscope/backend/broker/task_runner.py

# Tool-free history-library LLM; configure key only in the protected service env.
AGENTSCOPE_HISTORY_LLM_MODEL=deepseek-flash
AGENTSCOPE_HISTORY_LLM_URL=https://api.deepseek.com
AGENTSCOPE_HISTORY_LLM_KEY=
